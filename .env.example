# LLM
OPENAI_API_KEY=sk-...
# Official OpenAI: gpt-4o-mini etc. Relay (the5288): gpt-6-sol is cheapest at list price and behaves well
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL (proxy / compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server
PORT=3000
# Local: file:./data/app.db   Production (Turso): libsql://<db>-<org>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Default tenant (seeded by `npm run db:seed`)
OWNER_NAME=William
BOOKING_URL=https://cal.com/your-handle/intro
REPLY_SLA=within 24 hours

# Notifications: "console" (default) or "telegram"
NOTIFY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
