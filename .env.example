# LLM
OPENAI_API_KEY=sk-...
# Official OpenAI: gpt-4o-mini etc. Relay (the5288): gpt-6-sol is cheapest at list price and behaves well
OPENAI_MODEL=gpt-4o-mini
# Optional: custom base URL (proxy / compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server
PORT=3000
# Local: file:./data/app.db   Production (Turso): libsql://<db>-<org>.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Default tenant (seeded by `npm run db:seed`)
OWNER_NAME=William
BOOKING_URL=https://cal.com/your-handle/intro
REPLY_SLA=within 24 hours

# Notifications: "console" (default) or "telegram"
NOTIFY_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Abuse protection (optional overrides; defaults in src/config.ts)
# ALLOWED_ORIGINS=https://www.the5288.com,https://the5288.com,http://localhost:3000
# LIMIT_PER_MINUTE=100
# LIMIT_PER_DAY=1000
# LIMIT_GLOBAL_PER_DAY=20000
# LIMIT_MESSAGE_CHARS=1000
# LIMIT_TURNS_PER_CONVERSATION=40
# LIMIT_HISTORY_MESSAGES=24
# LIMIT_OUTPUT_TOKENS=600

# Model used for the one retry after a transient provider error (optional)
OPENAI_FALLBACK_MODEL=gpt-6-astra

# Platform / dashboard
# Comma-separated emails that become admins on signup
ADMIN_EMAILS=
# Where the dashboard is served (CSRF + email links)
APP_ORIGINS=https://www.the5288.com,http://localhost:3000
# Resend (https://resend.com) for lead notification emails; leave empty to log instead of send
RESEND_API_KEY=
EMAIL_FROM=LuckyYou Studio <onboarding@resend.dev>
